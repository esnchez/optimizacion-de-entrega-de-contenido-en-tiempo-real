{
  "uid": "temporal",
  "title": "Temporal: control-plane workflows",
  "tags": [
    "temporal",
    "content-delivery"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview: is the control plane healthy?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Workflows completed (1h)",
      "description": "PrescaleForEvent runs that finished successfully in the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(temporal_workflow_completed_total{job=\"temporal-worker\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Workflows failed (1h)",
      "description": "Runs that ended in failure in the last hour (for example, pods never became ready after all retries). Any value above 0 deserves a look in the Temporal UI.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(temporal_workflow_failed_total{job=\"temporal-worker\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Activity failed attempts (1h)",
      "description": "Failed activity attempts that Temporal retried. A few are normal: WaitForReadyReplicas fails on purpose until the pods are ready.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(temporal_activity_execution_failed_total{job=\"temporal-worker\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Worker up",
      "description": "1 when Prometheus can scrape the worker. 0 or no data: no worker is executing workflows, so started workflows wait.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up{job=\"temporal-worker\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Workflows and activities",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Workflow outcomes",
      "description": "Workflows finished per minute by outcome. Each PrescaleForEvent run shows up as one completed (or failed/canceled) point at the end of its hold time. Skipped: a run that found another prescale in progress and changed nothing (it still counts as completed).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 5,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (workflow_type) (increase(temporal_workflow_completed_total{job=\"temporal-worker\"}[1m]))",
          "legendFormat": "completed {{workflow_type}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (workflow_type) (increase(temporal_workflow_failed_total{job=\"temporal-worker\"}[1m]))",
          "legendFormat": "failed {{workflow_type}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (workflow_type) (increase(temporal_workflow_canceled_total{job=\"temporal-worker\"}[1m]))",
          "legendFormat": "canceled {{workflow_type}}",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (workflow_type) (increase(prescale_skipped_total{job=\"temporal-worker\"}[1m]))",
          "legendFormat": "skipped (overlap) {{workflow_type}}",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Activity attempts and failures",
      "description": "Activity attempts per minute (executions) and failed attempts (retried by Temporal). WaitForReadyReplicas fails while the new pods start: the retries are visible here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 5,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (activity_type) (increase(temporal_activity_execution_latency_seconds_count{job=\"temporal-worker\"}[1m]))",
          "legendFormat": "attempts {{activity_type}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (activity_type) (increase(temporal_activity_execution_failed_total{job=\"temporal-worker\"}[1m]))",
          "legendFormat": "failed {{activity_type}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Activity duration p95",
      "description": "How long each activity attempt takes (calls to the Kubernetes API). Seconds here would mean the API server is slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 5,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, activity_type) (rate(temporal_activity_execution_latency_seconds_bucket{job=\"temporal-worker\"}[5m])))",
          "legendFormat": "{{activity_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Task schedule-to-start p95",
      "description": "Time a task waits in the queue before a worker picks it up. Near zero is healthy; growing means no worker or too few slots.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 5,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_activity_schedule_to_start_latency_seconds_bucket{job=\"temporal-worker\"}[5m])))",
          "legendFormat": "activity tasks",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_workflow_task_schedule_to_start_latency_seconds_bucket{job=\"temporal-worker\"}[5m])))",
          "legendFormat": "workflow tasks",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Effect on the content service",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HPA minimum, desired and ready replicas",
      "description": "What PrescaleForEvent changes: the dashed minimum rises when a run starts, ready pods follow, and the minimum returns to its original value at the end of the hold.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 5,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "HPA minimum"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    6,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"cdn\", horizontalpodautoscaler=\"content-delivery\"}",
          "legendFormat": "HPA minimum",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"cdn\", horizontalpodautoscaler=\"content-delivery\"}",
          "legendFormat": "HPA desired",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_ready{namespace=\"cdn\", condition=\"true\", pod=~\"content-delivery-.*\"})",
          "legendFormat": "ready pods",
          "refId": "C"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "HPA minimum changed",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"cdn\", horizontalpodautoscaler=\"content-delivery\"}[1m]) > 0",
        "step": "30s",
        "titleFormat": "HPA minReplicas changed"
      }
    ]
  }
}
